{
  "name": "silos-pdf-prueba",
  "private": true,
  "type": "module",
  "description": "Prueba: el catálogo móvil de Silos impreso con Browser Rendering de Cloudflare",
  "scripts": {
    "prepare": "node prepare.mjs",
    "dev": "node prepare.mjs && wrangler dev --remote",
    "deploy": "node prepare.mjs && wrangler deploy",
    "borrar": "wrangler delete"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.137.0"
  }
}
