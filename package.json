{
  "name": "silos-paraguay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "setup": "node --env-file-if-exists=.env scripts/setup.js",
    "import": "node --env-file-if-exists=.env scripts/import-catalog.js",
    "admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "reset-admin": "node --env-file-if-exists=.env scripts/reset-admin.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "test": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:pdf": "node tests/pdf/generate.js"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "puppeteer": "^25.11.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  }
}
